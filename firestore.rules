rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if ownsUser(userId);
      allow create: if ownsUser(userId)
        && request.resource.data.role == 'intern'
        && request.resource.data.email == request.auth.token.email;
      allow update: if ownsUser(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email;
      allow delete: if false;

      match /{userCollection}/{document=**} {
        allow read, write: if ownsUser(userId);
      }
    }

    match /modules/{moduleId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /quizzes/{quizId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}